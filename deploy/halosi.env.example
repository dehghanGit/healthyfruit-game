APP_ENV=production
HOST=127.0.0.1
PORT=8080
WEB_THREADS=8
DB_PATH=/var/lib/halosi/health_battle.db
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Enable only after HTTPS is configured on Nginx.
COOKIE_SECURE=1
# Only when Waitress is bound to loopback behind the included Nginx config.
TRUST_PROXY=1
